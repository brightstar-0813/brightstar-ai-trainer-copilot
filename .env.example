# Shared secret between the bridge server and the Chrome extension.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
JT_BRIDGE_TOKEN=change-me
JT_BRIDGE_HOST=127.0.0.1
JT_BRIDGE_PORT=8765

# Preferred LLM engine (dashboard / `jt llm engine` write data/llm_prefs.yaml and override this).
# browser = Claude + ChatGPT tabs per config/models.yaml (recommended)
# auto | openai | anthropic | claude | gpt | manual
JT_LLM_ENGINE=browser

# --- Easiest path: put an API key here and skip the Chrome bridge for most tasks ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Octo Browser local API (default port 58888) and the profile that is logged in to LinkedIn
OCTO_API=http://localhost:58888
OCTO_PROFILE_UUID=
